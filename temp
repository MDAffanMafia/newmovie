from .models import ServerDetails, CertificateTypes, CertificateName, CertificateSubDetails


def build_cert_structure(server_id):
    structure = {}

    cert_types = CertificateTypes.objects.filter(server_id=server_id).prefetch_related(
        "certificatename_set__certificatesubdetails_set"
    )

    for ct in cert_types:
        ct_name = ct.certificateType
        structure[ct_name] = {}

        for cn in ct.certificatename_set.all():
            cn_name = cn.certificateName
            structure[ct_name][cn_name] = {}

            # assuming 1 subdetail per cert (if multiple, adjust)
            sub = cn.certificatesubdetails_set.first()
            if sub:
                structure[ct_name][cn_name] = {
                    "alias": sub.alias,
                    "fingerprint": sub.fingerprint,
                    "fingerprintType": sub.fingerprintType,
                    "validFrom": sub.validFrom,
                    "validTo": sub.validTo,
                    "owner": sub.owner,
                }

    return structure


def compare_cert_structure(pr, dr):
    result = {
        "missing_in_pr": [],
        "missing_in_dr": [],
        "property_mismatches": []
    }

    pr_types = set(pr.keys())
    dr_types = set(dr.keys())

    # Missing certificate types
    result["missing_in_pr"].extend(list(dr_types - pr_types))
    result["missing_in_dr"].extend(list(pr_types - dr_types))

    common_types = pr_types & dr_types

    for ct in common_types:
        pr_names = set(pr[ct].keys())
        dr_names = set(dr[ct].keys())

        # Missing cert names
        for name in (dr_names - pr_names):
            result["missing_in_pr"].append(f"{ct} -> {name}")

        for name in (pr_names - dr_names):
            result["missing_in_dr"].append(f"{ct} -> {name}")

        common_names = pr_names & dr_names

        for name in common_names:
            pr_props = pr[ct][name]
            dr_props = dr[ct][name]

            for key in pr_props:
                # 🔥 Ignore fields if needed
                if key in ["validFrom", "validTo"]:  # optional exclude
                    continue

                if pr_props.get(key) != dr_props.get(key):
                    result["property_mismatches"].append({
                        "path": f"{ct} -> {name}",
                        "property": key,
                        "pr": pr_props.get(key),
                        "dr": dr_props.get(key)
                    })

    return result


def compare_certificates(request):
    pr_server_id = request.GET.get("pr")
    dr_server_id = request.GET.get("dr")

    if not pr_server_id or not dr_server_id:
        return JsonResponse({"error": "Provide pr and dr server ids"}, status=400)

    pr_structure = build_cert_structure(pr_server_id)
    dr_structure = build_cert_structure(dr_server_id)

    result = compare_cert_structure(pr_structure, dr_structure)

    return JsonResponse(result, safe=False)





-- =========================================
-- 1. LAYERS TABLE
-- =========================================

CREATE TABLE server_layers (
    layer_id INT AUTO_INCREMENT PRIMARY KEY,
    layer_name VARCHAR(100) NOT NULL UNIQUE,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    INDEX idx_layer_name (layer_name)
);



-- =========================================
-- 2. APPLICATION STATUS / SERVERS TABLE
-- =========================================

CREATE TABLE application_status (
    id INT AUTO_INCREMENT PRIMARY KEY,

    serverHostName VARCHAR(100),
    ip VARCHAR(50) NOT NULL UNIQUE,

    LastSeen DATETIME,

    layer_id INT,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_application_layer
        FOREIGN KEY (layer_id)
        REFERENCES server_layers(layer_id)
        ON DELETE SET NULL,

    INDEX idx_ip (ip),
    INDEX idx_lastseen (LastSeen),
    INDEX idx_layer_id (layer_id)
);



-- =========================================
-- 3. BROKERS TABLE
-- =========================================

CREATE TABLE brokers (
    id INT AUTO_INCREMENT PRIMARY KEY,

    serverid INT NOT NULL,

    brokerName VARCHAR(100),

    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    status VARCHAR(50),

    port INT,

    isUp INT,

    processCount INT,

    timeout INT,

    closewait INT,

    established INT,

    udpPort INT,

    CONSTRAINT fk_broker_server
        FOREIGN KEY (serverid)
        REFERENCES application_status(id)
        ON DELETE CASCADE,

    INDEX idx_serverid (serverid),
    INDEX idx_brokername (brokerName),
    INDEX idx_status (status),
    INDEX idx_updated_at (updated_at)
);



-- =========================================
-- 4. BROKER RESTART TABLE
-- =========================================

CREATE TABLE brokerrestartTime (
    id INT AUTO_INCREMENT PRIMARY KEY,

    serverId INT NOT NULL,

    cacheHitTime VARCHAR(100),

    restartedAt VARCHAR(100),

    cacheHits INT,

    restartedAfter5M INT,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_restart_server
        FOREIGN KEY (serverId)
        REFERENCES application_status(id)
        ON DELETE CASCADE,

    INDEX idx_serverId (serverId),
    INDEX idx_restartedAt (restartedAt)
);



-- =========================================
-- 5. ISOLATOR STATUS TABLE
-- =========================================

CREATE TABLE IsolatorStatusCount (
    id INT AUTO_INCREMENT PRIMARY KEY,

    serverId INT NOT NULL,

    port INT,

    isUp INT,

    upCount INT,

