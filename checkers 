from sqlalchemy.ext.asyncio import create_async_engine, AsyncSession
from sqlalchemy.orm import sessionmaker, declarative_base

DATABASE_URL = "mysql+aiomysql://monitor:password@localhost/monitor_db"

engine = create_async_engine(
    DATABASE_URL,
    echo=False,
    pool_size=20,
    max_overflow=50
)

AsyncSessionLocal = sessionmaker(
    engine,
    expire_on_commit=False,
    class_=AsyncSession
)

Base = declarative_base()


async def get_db():
    async with AsyncSessionLocal() as session:
        yield session


from sqlalchemy import Column, Integer, String, Float, DateTime
from sqlalchemy.sql import func
from .database import Base


class ServerMetrics(Base):
    __tablename__ = "server_metrics"

    id = Column(Integer, primary_key=True, index=True)

    server_name = Column(String(100))
    cpu_usage = Column(Float)
    memory_usage = Column(Float)
    disk_usage = Column(Float)

    created_at = Column(DateTime(timezone=True), server_default=func.now())


from pydantic import BaseModel


class ServerMetricsCreate(BaseModel):
    server_name: str
    cpu_usage: float
    memory_usage: float
    disk_usage: float


from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select
from . import models


async def create_metrics(db: AsyncSession, metrics):

    db_metric = models.ServerMetrics(**metrics.dict())

    db.add(db_metric)

    await db.commit()

    await db.refresh(db_metric)

    return db_metric


async def get_last_week_metrics(db: AsyncSession):

    query = select(models.ServerMetrics).order_by(
        models.ServerMetrics.created_at.desc()
    ).limit(10000)

    result = await db.execute(query)

    return result.scalars().all()










